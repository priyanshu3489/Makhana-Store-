generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  flavor      String
  weightGrams Int
  pricePaise  Int
  compareAtPaise Int?
  imageUrl    String
  stock       Int         @default(0)
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
  purchases   InventoryPurchase[]
}


model Order {
  id                String        @id @default(cuid())
  orderNumber       Int           @unique @default(autoincrement())
  userId            String?
  customerName      String
  email             String
  phone             String
  address           String
  city              String
  state             String
  postalCode        String
  notes             String?
  subtotalPaise     Int
  discountPaise     Int           @default(0)
  shippingPaise     Int
  totalPaise        Int
  couponCode        String?
  paymentMethod     String        @default("RAZORPAY")
  status            OrderStatus   @default(PENDING)
  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  stockRestored     Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  customerOrderNumber Int

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@unique([userId, customerOrderNumber])
}


model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  productName    String
  unitPricePaise Int
  quantity       Int
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}


enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  PAYMENT_FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  COD_PENDING
}



model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Coupon {
  id                String   @id @default(cuid())
  code              String   @unique
  active            Boolean  @default(true)
  startsAt          DateTime?
  expiresAt         DateTime?
  usageLimit        Int?
  usedCount         Int      @default(0)
  minSubtotalPaise  Int      @default(0)
  discountType      String
  discountValue     Int
  maxDiscountPaise  Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
model WebhookEvent {
  id        String   @id
  event     String
  processed Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([processed])
}
model InventoryPurchase {
  id             String   @id @default(cuid())
  productId      String
  supplier       String
  reference      String?
  quantity       Int
  unitCostPaise  Int
  totalCostPaise Int
  notes          String?
  purchasedAt    DateTime @default(now())
  createdAt      DateTime @default(now())
  product        Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([purchasedAt])
  @@index([productId])
}
